# One local file: cp .env.example .env
# Shell TEST_ENV overrides this value. npm test defaults to dev.
TEST_ENV=dev

# DEV — public demo username profiles are stored in users.json
DEV_BASE_URL=https://saucedemo.com
DEV_ACCOUNT_MODE=demo
DEV_SAUCE_PASSWORD=

# STAGING — demo target; replace URL when a separate deployment is available
STAGING_BASE_URL=https://saucedemo.com
STAGING_ACCOUNT_MODE=demo
STAGING_SAUCE_PASSWORD=

# PRODUCTION — currently the same public demo target
PRODUCTION_BASE_URL=https://saucedemo.com
PRODUCTION_ACCOUNT_MODE=demo
PRODUCTION_SAUCE_PASSWORD=
# Only required with PRODUCTION_ACCOUNT_MODE=real
PRODUCTION_SAUCE_USERNAME=

# CI can supply unprefixed BASE_URL, ACCOUNT_MODE, SAUCE_PASSWORD, and
# SAUCE_USERNAME for the selected GitHub Environment; no .env file is needed.
