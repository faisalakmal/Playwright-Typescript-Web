{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "src/**/*.ts", "tests/ui/**/*.ts"],
  "exclude": ["node_modules", "src/api", "tests/api"]
}
